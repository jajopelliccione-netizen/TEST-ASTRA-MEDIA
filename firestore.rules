rules_version = '2';

// ============================================================================
//  Astra Agency — Regole di sicurezza Firestore
// ----------------------------------------------------------------------------
//  Questo file rispecchia le regole attive nella console Firebase, con 3
//  correzioni consigliate rispetto alla versione precedente (vedi NB accanto
//  a ogni blocco modificato). Ha effetto SOLO dopo il deploy:
//    firebase deploy --only firestore:rules
//  oppure incollando il contenuto nella console → Firestore → Regole → Pubblica.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // "owner" = admin con ruolo 'owner' (non il proprietario di un documento)
    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

    // ── Copioni: lettura/scrittura solo admin ──────────────────────────────
    match /copioni/{id} {
      allow read, write: if isAdmin();
    }

    // ── Alias username→email: lettura pubblica (serve al login admin) ───────
    match /auth_aliases/{alias} {
      allow read: if true;
      allow create, delete: if isOwner();
    }

    // ── CLIENTI ─────────────────────────────────────────────────────────────
    // NB (correzione): il cliente ora può AGGIORNARE il PROPRIO documento, ma
    // SOLO i campi 'websiteDraft' e 'siteConfig' (approvazione bozza sito e
    // questionario). Senza questo, quelle funzioni della dashboard cliente
    // davano "permission denied". Creazione/eliminazione restano solo admin.
    match /clients/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['websiteDraft', 'siteConfig']));
    }

    // ── ADMINS ───────────────────────────────────────────────────────────────
    // NB (correzione): la lettura è ora limitata al PROPRIO doc o agli admin,
    // invece di essere aperta a qualsiasi utente autenticato (evita che un
    // cliente/registrato possa enumerare gli account admin).
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if isOwner() && uid != request.auth.uid;
      allow delete: if isOwner() && uid != request.auth.uid;
    }

    // ── UTENTI REGISTRATI dal sito ──────────────────────────────────────────
    // NB (aggiunta): serve alla registrazione self-service. L'utente crea/legge
    // SOLO il proprio documento e SOLO con ruolo 'registered' (niente
    // auto-promozione). La promozione a cliente la fa l'admin.
    // Se in futuro togliete la registrazione, questa regola resta innocua.
    match /users/{uid} {
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == 'registered';
      allow update, delete: if isAdmin();
    }

    // ── Form pubblici: chiunque può inviare, gestione solo admin ────────────
    match /partners/{id} { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /contacts/{id} { allow create: if true; allow read, update, delete: if isAdmin(); }

    // ── Token notifiche push (FCM): solo il proprio admin ───────────────────
    match /admin_tokens/{uid} {
      allow read, write: if isAdmin() && request.auth.uid == uid;
      allow delete: if isOwner();
    }

    // ── Analytics: il cliente legge i propri dati; scrittura solo admin ─────
    match /analytics/{clientId}/{rest=**} {
      allow read: if request.auth != null && (request.auth.uid == clientId || isAdmin());
      allow write: if isAdmin();
    }

    // ── Config pubblica del sito (promo, visibilità sezioni) ────────────────
    match /config/{doc} { allow read: if true; allow write: if isAdmin(); }

    // ── Bozze preventivi: solo admin ────────────────────────────────────────
    match /preventivi_bozze/{id} { allow read, write: if isAdmin(); }

  }
}
