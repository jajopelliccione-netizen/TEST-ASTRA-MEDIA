rules_version = '2';

// ============================================================================
//  Astra Agency — Regole di sicurezza Firestore
// ----------------------------------------------------------------------------
//  Questo file rispecchia le regole attive nella console Firebase. Ha effetto
//  SOLO dopo il deploy:
//    firebase deploy --only firestore:rules
//  oppure incollando il contenuto nella console → Firestore → Regole → Pubblica.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

        // Copioni: lettura/scrittura solo per gli admin
    match /copioni/{id} {
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /auth_aliases/{alias} { allow read: if true; allow create, delete: if isOwner(); }

    // NB (multi-brand): un doc clients/{id} può essere un "brand" aggiuntivo
    // collegato al login di un altro cliente tramite ownerUid — in quel caso
    // il doc ID non coincide con l'auth uid, quindi la lettura è concessa
    // anche quando resource.data.ownerUid corrisponde all'utente loggato.
    // NB (soci/collaboratori): più persone possono avere un login proprio ma
    // vedere lo stesso cliente — il loro uid viene aggiunto a
    // collaboratorUids sul doc del cliente/brand condiviso.
    match /clients/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid || isAdmin()
        || resource.data.get('ownerUid', '') == request.auth.uid
        || request.auth.uid in resource.data.get('collaboratorUids', [])
      );
      allow write: if isAdmin();
    }

    match /admins/{uid} { allow read: if request.auth != null; allow create: if isOwner() && uid != request.auth.uid; allow delete: if isOwner() && uid != request.auth.uid; }
    match /partners/{id} { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /contacts/{id} { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /admin_tokens/{uid} { allow read, write: if isAdmin() && request.auth.uid == uid; allow delete: if isOwner(); }

    // NB (multi-brand + soci): clientId può essere l'id di un brand
    // secondario (non l'auth uid) — si verifica quindi anche se il brand
    // appartiene (ownerUid) o è condiviso (collaboratorUids) con l'utente
    // loggato.
    match /analytics/{clientId}/{rest=**} {
      allow read: if request.auth != null && (
        request.auth.uid == clientId || isAdmin()
        || get(/databases/$(database)/documents/clients/$(clientId)).data.get('ownerUid', '') == request.auth.uid
        || request.auth.uid in get(/databases/$(database)/documents/clients/$(clientId)).data.get('collaboratorUids', [])
      );
      allow write: if isAdmin();
    }

    match /config/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /preventivi_bozze/{id} { allow read, write: if isAdmin(); }

  }
}
