# Copia questo file in `.env` e compila i valori.
# `.env` e' in .gitignore: non finisce mai nel repository (che e' pubblico).

# ── Database ────────────────────────────────────────────────────────────
# SQLite per iniziare. I dati dei lead stanno qui: il file NON va committato.
DATABASE_URL="file:./data/outreach.db"

# ── LLM (generazione email e lettura risposte) ──────────────────────────
GROQ_API_KEY=""
# oppure
ANTHROPIC_API_KEY=""

# ── Invio email ─────────────────────────────────────────────────────────
# Dominio SECONDARIO dedicato, mai la Gmail personale.
MITTENTE_EMAIL="info@astra-proposte.it"
MITTENTE_NOME="Astra Agency"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# INTERRUTTORE GENERALE. Finche' non e' "true" il sistema fa tutto il giro
# (bozza, approvazione, tasto, cambio di stato) ma NON consegna nulla a
# nessuno. Mettilo a true SOLO dopo aver configurato SPF/DKIM/DMARC e la
# pagina di disiscrizione funzionante.
INVIO_ATTIVO="false"

# Tetto giornaliero: si parte basso e si sale piano, altrimenti il dominio brucia
INVII_MAX_GIORNO="25"

# ── Dati obbligatori per legge nel piè di pagina di ogni email ──────────
AZIENDA_RAGIONE_SOCIALE="Astra Agency"
AZIENDA_INDIRIZZO=""
AZIENDA_PIVA=""
# Base dei link di disiscrizione (deve funzionare davvero)
URL_DISISCRIZIONE="https://astragency.it/disiscrizione"
