# Copia questo file in `.env` e compila i valori.
# `.env` e' in .gitignore: non finisce mai nel repository (che e' pubblico).

# ── Database ────────────────────────────────────────────────────────────
# Online (Vercel + Neon) la variabile la imposta l'integrazione da sola.
# In locale, per provare senza database esterno, metti "sqlite" come provider
# in prisma/schema.prisma e qui: DATABASE_URL="file:./data/outreach.db"
DATABASE_URL=""

# ── Accesso alla dashboard ──────────────────────────────────────────────
# Una volta online l'indirizzo e' pubblico e dentro ci sono dati personali
# dei lead: senza queste due variabili non si entra, e non per modo di dire
# (il modulo di accesso si rifiuta proprio di funzionare).
# Generale con: npm run password -- "la tua password"
PASSWORD_HASH=""
SESSION_SECRET=""

# ── LLM (generazione email e lettura risposte) ──────────────────────────
GROQ_API_KEY=""
# oppure
ANTHROPIC_API_KEY=""

# ── Invio email ─────────────────────────────────────────────────────────
# Dominio SECONDARIO dedicato, mai la Gmail personale.
# Mittente: sottodominio DEDICATO, autenticato su Brevo. Mai la casella con
# cui lavori, e mai una Gmail (le condizioni di Google vietano l'invio a
# freddo e rischieresti l'account).
MITTENTE_EMAIL="proposte@proposte.astragency.it"
MITTENTE_NOME="Astra Agency"

# Dove arrivano le risposte: una casella vera, sullo stesso dominio del
# mittente (se il dominio non combacia i filtri antispam lo notano).
# E' anche la casella che il worker delle risposte leggera' via IMAP.
REPLY_TO="info@astragency.it"

# Lettura delle risposte (passo 5) — casella Aruba
IMAP_HOST="imaps.aruba.it"
IMAP_PORT="993"
IMAP_USER="info@astragency.it"
IMAP_PASSWORD=""
# Brevo, API HTTP (non SMTP: sui Worker di Cloudflare non si possono aprire
# connessioni SMTP, e una chiamata HTTP dice molto piu' chiaramente cosa e'
# andato storto). Il piano gratuito da' 300 email al giorno: noi ne mandiamo
# 10-25.
#
# ATTENZIONE: serve una CHIAVE API, non la chiave SMTP. Su Brevo stanno in
# due schede diverse della stessa pagina: Impostazioni -> SMTP e API ->
# scheda "Chiavi API". E' una password: chi ce l'ha puo' mandare email a
# nome tuo.
BREVO_API_KEY=""

# INTERRUTTORE GENERALE. Finche' non e' "true" il sistema fa tutto il giro
# (bozza, approvazione, tasto, cambio di stato) ma NON consegna nulla a
# nessuno. Mettilo a true SOLO dopo aver configurato SPF/DKIM/DMARC e la
# pagina di disiscrizione funzionante.
INVIO_ATTIVO="false"

# Tetto giornaliero: si parte basso e si sale piano, altrimenti il dominio brucia
INVII_MAX_GIORNO="25"

# ── Dati obbligatori per legge nel piè di pagina di ogni email ──────────
AZIENDA_RAGIONE_SOCIALE="Astra Agency"

# Da compilare se e quando aprirai la partita IVA. Oggi (prestazione
# occasionale) resta vuota e non blocca niente: la legge impone di
# identificarsi, non di avere una partita IVA.
AZIENDA_PIVA=""

# Informativa privacy: e' li' che il destinatario trova chi e' il titolare
# del trattamento e come far cancellare i propri dati. Nell'email ci va il
# link, non l'intera burocrazia.
URL_PRIVACY="https://astragency.it/privacy"
# Base dei link di disiscrizione (deve funzionare davvero)
URL_DISISCRIZIONE="https://astragency.it/api/disiscrizione"

# Firma dei link di disiscrizione. DEVE essere identico al secret
# UNSUBSCRIBE_SECRET impostato nel Worker su Cloudflare: se differiscono, i
# link smettono di funzionare senza dare errore.
UNSUBSCRIBE_SECRET=""

# Per rileggere dal sito chi si e' disiscritto. Identico a ADMIN_API_KEY
# nel Worker.
URL_API_SITO="https://astragency.it/api"
ADMIN_API_KEY=""
