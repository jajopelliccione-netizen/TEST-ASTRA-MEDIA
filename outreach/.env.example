# Copia questo file in `.env` e compila i valori.
# `.env` e' in .gitignore: non finisce mai nel repository (che e' pubblico).

# ── Database ────────────────────────────────────────────────────────────
# SQLite per iniziare. I dati dei lead stanno qui: il file NON va committato.
DATABASE_URL="file:./data/outreach.db"

# ── LLM (generazione email e lettura risposte) ──────────────────────────
GROQ_API_KEY=""
# oppure
ANTHROPIC_API_KEY=""

# ── Invio email ─────────────────────────────────────────────────────────
# Dominio SECONDARIO dedicato, mai la Gmail personale.
# Mittente: sottodominio DEDICATO, autenticato su Brevo. Mai la casella con
# cui lavori, e mai una Gmail (le condizioni di Google vietano l'invio a
# freddo e rischieresti l'account).
MITTENTE_EMAIL="proposte@proposte.astragency.it"
MITTENTE_NOME="Astra Agency"

# Dove arrivano le risposte: una casella vera, sullo stesso dominio del
# mittente (se il dominio non combacia i filtri antispam lo notano).
# E' anche la casella che il worker delle risposte leggera' via IMAP.
REPLY_TO="info@astragency.it"

# Lettura delle risposte (passo 5) — casella Aruba
IMAP_HOST="imaps.aruba.it"
IMAP_PORT="993"
IMAP_USER="info@astragency.it"
IMAP_PASSWORD=""
# Brevo — valori dell'account AstraAgency (il piano gratuito da' 300 email
# al giorno, piu' che sufficienti: noi ne mandiamo 10-25).
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="ad3fbf001@smtp-brevo.com"
# La chiave SMTP generata da Brevo. E' una password: chi ce l'ha puo' mandare
# email a nome tuo. Sta solo qui, e questo file non entra mai in git.
SMTP_PASSWORD=""

# INTERRUTTORE GENERALE. Finche' non e' "true" il sistema fa tutto il giro
# (bozza, approvazione, tasto, cambio di stato) ma NON consegna nulla a
# nessuno. Mettilo a true SOLO dopo aver configurato SPF/DKIM/DMARC e la
# pagina di disiscrizione funzionante.
INVIO_ATTIVO="false"

# Tetto giornaliero: si parte basso e si sale piano, altrimenti il dominio brucia
INVII_MAX_GIORNO="25"

# ── Dati obbligatori per legge nel piè di pagina di ogni email ──────────
AZIENDA_RAGIONE_SOCIALE="Astra Agency"
AZIENDA_INDIRIZZO=""
AZIENDA_PIVA=""
# Base dei link di disiscrizione (deve funzionare davvero)
URL_DISISCRIZIONE="https://astragency.it/disiscrizione"
