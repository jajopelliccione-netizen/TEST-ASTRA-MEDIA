{
  "name": "astra-outreach",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema di outreach di Astra Agency: ricerca lead, analisi sito, email su misura, gestione risposte e call.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "verifica": "cp ../cloudflare-worker/worker.js /tmp/_w.mjs && node --check /tmp/_w.mjs && tsx prove/firma.ts",
    "prove": "tsx prove/firma.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "password": "tsx prove/password.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}